rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users collection
    // users/{uid}: a user can read and update only their own document; admin can read, update and delete any.
    // Self-update uses .get('field', null) for safe field comparisons on role, approvalStatus, suspensionReason, and ownerDetails.approvalStatus.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && (request.resource.data.role == 'vehicle_owner' || request.resource.data.role == 'renter')
        && request.resource.data.approvalStatus != 'suspended';

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('approvalStatus', null) == resource.data.get('approvalStatus', null)
        && request.resource.data.get('suspensionReason', null) == resource.data.get('suspensionReason', null)
        && request.resource.data.get(['ownerDetails', 'approvalStatus'], null) == resource.data.get(['ownerDetails', 'approvalStatus'], null)
      );

      allow delete: if isAdmin();
    }

    // 2. Vehicles collection
    // Read: non-owner, non-admin readers require resource.data.ownerSuspended == false and approvalStatus == 'approved'.
    // Create: Owners can create vehicles with ownerId == their uid and approvalStatus == "pending_approval".
    // Update: Owners can update their own vehicles but CANNOT change dailyRate, ownerSuspended, ownerId or approvalStatus. Renters can update status from 'available' to 'booked' during booking.
    // Delete: ONLY admin can delete vehicles.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.ownerId == request.auth.uid
        || (resource.data.approvalStatus == 'approved' && resource.data.ownerSuspended == false)
      );

      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.approvalStatus == 'pending_approval'
      );

      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.dailyRate == resource.data.dailyRate
        && request.resource.data.ownerSuspended == resource.data.ownerSuspended
      ) || (
        isSignedIn()
        && resource.data.status == 'available'
        && request.resource.data.status == 'booked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );

      allow delete: if isAdmin();
    }

    // 3. Bookings collection
    // Customer can create booking with their own uid as customerId and read their own.
    // Owner can read bookings for their own cars and update only owner approval fields.
    // Customer can update status only from 'confirmed' to 'cancelled' along with cancellation fields.
    // Admin can read and write all.
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );

      allow create: if isSignedIn() && (
        isAdmin()
        || request.resource.data.customerId == request.auth.uid
      );

      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerApprovalStatus', 'ownerApprovalNotes'])
      ) || (
        isSignedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellationReason', 'cancelledAt', 'cancelledBy'])
      );

      allow delete: if isAdmin();
    }

    // 4. Payouts collection
    // Read: admin or vehicle owner.
    // Create: ONLY admin can create payouts.
    // Update & Delete: admin only.
    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.ownerId == request.auth.uid
      );

      allow create, update, delete: if isAdmin();
    }

    // 5. Disputes collection
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.reporterId == request.auth.uid
      );

      allow create: if isSignedIn() && (
        isAdmin()
        || request.resource.data.reporterId == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    // 6. Audit Logs collection
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      
      allow create: if isSignedIn() && (
        isAdmin()
        || request.resource.data.actor.id == request.auth.uid
      );

      allow update: if false;
      allow delete: if isAdmin();
    }

    // 7. Maintenance collection
    match /maintenance/{maintId} {
      allow read, write: if isAdmin();
    }

    // 8. Platform Settings collection
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
